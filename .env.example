# Repositories the server serves, comma separated
TRIAGE_REPOS=owner/repo

# Token for reading issues and posting comments (needs issues: write to post)
GITHUB_TOKEN=

# sha256 hex of each API key, comma separated. Make one with:
#   key=$(openssl rand -hex 24); echo "key: $key"; printf %s "$key" | shasum -a 256
TRIAGE_API_KEYS=

# Secret set on the GitHub webhook (issues events). Without it the webhook is refused.
TRIAGE_WEBHOOK_SECRET=

# Optional
# TRIAGE_CORS_ORIGINS=https://dashboard.example.com
# TRIAGE_RATE_PER_MINUTE=60
# TRIAGE_ASK_CALLS_PER_DAY=200
# TRIAGE_SYNC_MINUTES=60
# TRIAGE_LLM_KEY=          # key for models.llm, if it needs one
# OPENAI_API_KEY=          # for OpenAI embeddings or models that use it
