# GitHub API Configuration (Optional - increases rate limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=your_github_token_here

# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (Optional - defaults to gpt-4-turbo-preview)
OPENAI_MODEL=gpt-4o

# Database Configuration (Optional - defaults to github_issues.db)
DATABASE_PATH=github_issues.db
