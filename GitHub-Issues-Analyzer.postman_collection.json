	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						""
					]
				},
				"description": "Check if the API is running and get basic information about available endpoints."
			},
			"response": []
		},
		{
			"name": "Scan Repository - Small (Hello World)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('repo');",
							"    pm.expect(jsonData).to.have.property('issues_fetched');",
							"    pm.expect(jsonData).to.have.property('cached_successfully');",
							"});",
							"",
							"pm.test(\"Caching was successful\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.cached_successfully).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"repo\": \"octocat/Hello-World\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/scan",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"scan"
					]
				},
				"description": "Scan a small test repository (octocat/Hello-World) to fetch and cache open issues."
			},
			"response": []
		},
