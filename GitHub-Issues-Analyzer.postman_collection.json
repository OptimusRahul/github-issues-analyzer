							"    pm.expect(jsonData).to.have.property('analysis');",
							"    pm.expect(jsonData.analysis).to.be.a('string');",
							"    pm.expect(jsonData.analysis.length).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
